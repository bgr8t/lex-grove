# Lex Grove environment template
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER commit a populated .env file. Use a secrets manager for production.
#
# Server-side keys (no `VITE_` prefix) are read by the Express API server in
# `Backend/api-server-simple.js` / `Backend/api-server-updated.ts`. They are
# never exposed to the browser bundle.
#
# Client-side keys (`VITE_*`) are inlined into the production JavaScript by
# Vite. Only put values here that are safe to publish (Firebase web config and
# Stripe publishable keys are designed for this; secret API keys are not).

# ---------- Firebase (web client config; safe to ship to browsers) ----------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------- Stripe ----------
# Publishable key is meant to be public.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Optional product / payment link surfaced to the client.
VITE_STRIPE_PRICE_ID=price_your_price_id
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_link
# Secret key MUST stay server-side. Never prefix with VITE_.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ---------- AI services (server-side only) ----------
OPENAI_API_KEY=sk-your_openai_key
GROK_API_KEY=gsk_your_groq_key
GEMINI_API_KEY=your_gemini_key
ELEVENLABS_API_KEY=sk_your_elevenlabs_key

# ---------- Pinecone (server-side only) ----------
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_URL=https://your-index.svc.pinecone.io
PINECONE_INDEX_NAME=your_index_name

# ---------- App config (client-side) ----------
VITE_ADMIN_UID=your_firebase_admin_uid
VITE_REGISTRATION_CODE=your_registration_code

# ---------- Express server (only required if you run api-server-updated.ts) ----------
SESSION_SECRET=replace_with_a_long_random_string
MONGO_URL=mongodb://localhost:27017/lex-grove-sessions
NODE_ENV=development
PORT=3000
